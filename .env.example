# AZ Contractor Pro CRM - Environment Configuration
# Copy to .env and fill in. Every value is optional except the admin login.

# ---- Server ----
PORT=3100
# Public URL of this CRM. Lead capture URLs and the Stripe webhook URL are built from it.
BASE_URL=http://localhost:3100
# SQLite file. On Render/Railway/Fly, point this at a persistent disk (e.g. /data/crm.db).
DATABASE_PATH=./data/crm.db
NODE_ENV=development

# ---- First admin login (created on first start if no users exist) ----
ADMIN_EMAIL=admin@azcontractorpro.com
ADMIN_PASSWORD=change-me-to-something-long

# ---- Integrations ----
# Shared key for the Site Builder and payment server. Sent as the x-builder-key header,
# same convention as the builder's backend mode. You can also create named keys in Settings.
BUILDER_KEY=

# Claude API key for the AI proxy (/api/integrations/ai/messages). The builder's copy
# generation can point here so every token is attributed to a contractor.
ANTHROPIC_API_KEY=
# Upper bound on max_tokens for proxied requests
AI_MAX_TOKENS=4096

# ---- Lead notifications (same SMTP settings as payment-server.js) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=leads@azcontractorpro.com
# Gets a BCC of every lead email. Defaults to ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL=

# ---- Stripe (optional) ----
# payment-server.js already reports orders to the CRM. Add a Stripe webhook endpoint for
# BASE_URL/hooks/stripe as well if you want a backup path and refund tracking; paste its
# signing secret (whsec_...) here. No Stripe API key is needed.
STRIPE_WEBHOOK_SECRET=
